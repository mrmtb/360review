@model IEnumerable<reviews.Models.Evaluation>

@{
    ViewBag.Title = "Manage Tables";
    var selectedModel = ViewData["SelectedModel"]?.ToString() ?? "Evaluations";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h4 class="mb-0">Manage Tables</h4>
    <div class="d-flex gap-2">
        <select class="form-select" id="modelSelect" name="selectedTable" aria-label="Select table to manage">
            <option value="GetEvaluationsForManage" selected="@(selectedModel == "Evaluations" ? "selected" : null)">Evaluations</option>
            <option value="GetClientsForManage" selected="@(selectedModel == "Clients" ? "selected" : null)">Clients</option>
            <option value="GetEmailTemplatesForManage" selected="@(selectedModel == "EmailTemplates" ? "selected" : null)">Email Templates</option>
        </select>
        <button type="button" class="btn btn-primary" id="createNewBtn">
            <i class="bi bi-plus-circle me-1"></i> Create New
        </button>
    </div>
</div>

<div id="manageContainer" class="table-responsive">
    <div class="p-3 text-muted">Loading...</div>
</div>

<div id="detailsContainer" class="mt-4" data-autofocus-scope></div>

@section Scripts {
    <script src="/js/pages/admin-manage-index.js" asp-append-version="true"></script>
}
