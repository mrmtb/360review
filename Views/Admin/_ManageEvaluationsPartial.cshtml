@using reviews.Models

@model IEnumerable<Evaluation>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-hover table-condensed">
        <thead>
            <tr>
                <th>Evaluation Name</th>
                <th>Client</th>
                <th>Active</th>
                <th>Email Testing</th>
                <th>Open Date</th>
                <th>Due Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr class="align-middle">
                <td>@item.EvaluationName</td>
                <td>@item.Client?.ClientName</td>
                <td>@(item.EvaluationActive ? "Yes" : "No")</td>
                <td>@(item.EvaluationTestEmails ? "Yes" : "No")</td>
                <td>@(item.EvaluationOpenDate is DateTime dt1 ? dt1.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : "")</td>
                <td>@(item.EvaluationRateeDueDate is DateTime dt2 ? dt2.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : "")</td>
                <td>
                    <button class="btn btn-sm btn-primary load-details" data-url="GetEvaluationDetails" data-id="@item.EvaluationId">
                        <i class="bi bi-pencil-square"></i> Details
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <span class="form-control-plaintext">Nothing returned. </span>
}