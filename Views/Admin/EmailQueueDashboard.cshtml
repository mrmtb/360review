@model IEnumerable<reviews.Models.EmailQueue>

@{
    ViewBag.Title = "Email Queue Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
}

<h4>Email Queue Dashboard</h4>

<table class="table table-striped table-hover table-sm" id="emailQueueTable">
    <thead>
        <tr>
            <th>Recipient</th>
            <th>Subject</th>
            <th>Status</th>
            <th>Testing</th>
            <th>Queued At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var email in Model)
        {
            <tr data-email-id="@email.EmailQueueId">
                <td>@email.EmailTo</td>
                <td>@email.EmailSubject</td>
                <td>@(email.EmailSent ? "Sent" : "Pending")</td>
                <td>@(email.EmailTest ? "Yes" : "")</td>
                <td>@email.EmailQueuedDateTime.ToString("g")</td>
                <td>
                    <button class="btn btn-sm btn-primary preview-email" data-email-id="@email.EmailQueueId" itemid="@email.EmailQueueId">Preview</button>
                    @if (!email.EmailSent)
                    {
                        <a href="@Url.Action("RetryEmail", new { id = email.EmailQueueId })" class="btn btn-sm btn-warning">Retry</a>
                        <a href="@Url.Action("CancelEmail", new { id = email.EmailQueueId })" class="btn btn-sm btn-danger">Cancel</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"> </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.8.4/moment.min.js"></script>
    <script src="https://cdn.datatables.net/plug-ins/2.3.2/sorting/datetime-moment.js"></script>

    <script>
        $(document).ready(function () {
            $('.preview-email').on('click', function () {
                var emailId = $(this).data('email-id');

                // Load the preview content via AJAX
                $.get('@Url.Action("PreviewEmail")', { id: emailId }, function (data) {
                    $('#emailPreviewModal .modal-body').html(data);
                    $('#emailPreviewModal').modal('show');
                });
            });

            $.fn.dataTable.moment('M/D/YYYY LT', 'en');

            $('#emailQueueTable').DataTable({
                "searching": true,
                "pageLength": 25,
                columnDefs: [
                    { targets: -1, orderable: false }, 
                ]
            });

        });
    </script>
}

<!-- Modal Structure -->
<div class="modal fade" id="emailPreviewModal" tabindex="-1" aria-labelledby="emailPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="emailPreviewModalLabel">Email Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Content will be loaded dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
