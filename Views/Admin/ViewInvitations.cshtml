@model IEnumerable<vwInvitations>

@{
    ViewBag.Title = "Manage Invitations";
    var invitations = Model?.ToList() ?? new List<vwInvitations>();
    var hasInvitations = invitations.Any();
}

@section Styles {
    <link rel="stylesheet" href="/vendor/datatables/dataTables.bootstrap5.min.css">
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Invitation Queue</h4>
    <form method="post" asp-action="ProcessInvitations" data-busy-submit data-busy-text="Processing..." class="@(hasInvitations ? "" : "d-none")">
        <button type="submit" id="processInvitationsBtn" class="btn btn-primary" title="Process Invitations" disabled data-confirm="Process all remaining invitations in the queue?">
            <i class="bi bi-envelope-plus"></i> Process Invitations
        </button>
    </form>
</div>

@if (!hasInvitations)
{
    @await Html.PartialAsync("_EmptyState", new ViewDataDictionary(ViewData)
    {
        ["IconClass"] = "bi bi-envelope-check",
        ["Title"] = "Invitation queue is clear",
        ["Message"] = "There are no pending invitations to process."
    })
}
else
{
    <table class="table table-hover table-sm align-middle mobile-stack" id="invitationsTable">
        <thead>
            <tr>
                <th>Recipient</th>
                <th>Role</th>
                <th>Ratee</th>
                <th>Client Name</th>
                <th>Email Type</th>
                <th></th>
            </tr>
        </thead>
        <tbody>

        @foreach (var p in invitations)
        {
            <tr class="align-middle">
                <td data-label="Recipient">@p.RaterLastName, @p.RaterFirstName</td>
                <td data-label="Role">@p.RaterRole</td>
                <td data-label="Ratee">@p.RateeLastName, @p.RateeFirstName</td>
                <td data-label="Client Name">@p.ClientName</td>
                <td data-label="Email Type">@p.MessageToSend</td>
                <td data-label="Actions">
                    <button type="button"
                       class="btn btn-sm js-invite-action"
                       hx-post="@Url.Action("InviteParticipantAjax", "Admin")"
                       hx-vals='{"evaluationRateeId":"@p.EvaluationRateeId","participantId":"@p.RaterParticipantId"}'
                       hx-swap="none">
                        <i class="bi bi-calendar-event"></i>&nbsp;Invite
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <nav>
        <ul class="pagination justify-content-center pagination-sm" id="pagination"></ul>
    </nav>
}

@section Scripts {
    @if (hasInvitations)
    {
        <script src="/vendor/datatables/dataTables.min.js"></script>
        <script src="/vendor/datatables/dataTables.bootstrap5.min.js"></script>
        @await Html.PartialAsync("_DataTableInit", new ViewDataDictionary(ViewData)
        {
            ["Selector"] = "#invitationsTable",
            ["PageLength"] = "25",
            ["SaveState"] = "false",
            ["OrderJs"] = "[[3, 'asc']]",
            ["ColumnDefsJs"] = "[{ targets: -1, orderable: false }]",
            ["SearchPlaceholder"] = "Search invitations..."
        })
    }
    <script src="/js/pages/admin-view-invitations.js" asp-append-version="true"></script>
}
