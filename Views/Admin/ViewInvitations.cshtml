@model IEnumerable<vwInvitations>

@{
    ViewBag.Title = "Manage Invitations";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.0/css/dataTables.bootstrap5.min.css">
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Invitation Queue</h4>
    <form method="post" asp-action="ProcessInvitations">
        <button type="submit" id="processInvitationsBtn" class="btn btn-primary" title="Process Invitations" disabled>
            <i class="bi bi-envelope-plus"></i> Process Invitations
        </button>
    </form>
</div>

<table class="table table-hover table-sm align-middle" id="invitationsTable">
    <thead>
        <tr>
            <th>Recipient</th>
            <th>Role</th>
            <th>Ratee</th>
            <th>Client Name</th>
            <th>Email Type</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

    @foreach (var p in Model)
    {
        <tr class="align-middle">
            <td>@p.RaterLastName, @p.RaterFirstName</td>
            <td>@p.RaterRole</td>
            <td>@p.RateeLastName, @p.RateeFirstName</td>
            <td>@p.ClientName</td>
            <td>@p.MessageToSend</td>
            <td>
                <a asp-action="InviteParticipant" asp-controller="Admin" 
                   asp-route-evaluationRateeId="@p.EvaluationRateeId" 
                   asp-route-participantId="@p.RaterParticipantId" 
                   class="btn btn-sm">
                    <i class="bi bi-calendar-event"></i>&nbsp;Invite
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination justify-content-center pagination-sm" id="pagination"></ul>
</nav>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#invitationsTable').DataTable({
                responsive: true,
                pageLength: 25,
                order: [[3, 'asc']],
                columnDefs: [
                    { targets: -1, orderable: false }
                ],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search invitations..."
                }
            });
        });
    </script>
}