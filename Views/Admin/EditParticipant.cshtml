@model reviews.Models.AdminParticipantViewModel

@{
    ViewBag.Title = "Edit Participant";
}

<h4>Edit Participant</h4>

<div class="form-group">
    <label>Evaluations</label>
    @if (Model.Evaluations != null && Model.Evaluations.Any())
    {
        <select class="form-select" id="evaluationSelect" name="SelectedEvaluationId" data-url="@Url.Action("GetRatersForEvaluation", "Admin")" data-url2="@Url.Action("GetRateesForEvaluation", "Admin")">
            @foreach (var item in Model.Evaluations.OrderByDescending(e => e.EvaluationRaterDueDate))
            {
                <option value="@item.EvaluationId">
                    @item.EvaluationName (@(item.EvaluationActive ? "Active" : "Inactive"))
                </option>
            }
        </select>
    }
    else
    {
        <span class="form-control-plaintext">No evaluations found.</span>
    }
</div>

<div class="form-group">
    <h4>Evaluations with this participant as Ratee</h4>
    @if (Model.Raters != null)
    {
    <table class="table table-striped table-hover table-condensed" id="ratersContainer">
        <thead>
            <tr>
                <th>Rater Name</th>
                <th>Completing As</th>
                <th>Last Email</th>
                <th>Status</th>
            </tr>
        </thead>    
    @foreach (var item in Model.Raters)
    {
        <tr class="align-middle">
            <td>@item.ParticipantNameFirst @item.ParticipantNameLast (@item.ParticipantEmail)</td>
            <td>@item.ParticipantRoleName</td>
            <td>@item.EvaluationParticipantDateLastEmailed?.ToString("g")</td>
            <td>
                <a class="btn btn-sm btn-sm-nopad">
                    @Html.Raw(item.EvaluationParticipantStatusDecoration)
                    @item.EvaluationParticipantStatusName
                </a>
            </td>
        </tr>
    }
    </table>
    }
    else
    {
        <span class="form-control-plaintext">No Raters found.</span>
    }
</div>

<div class="form-group">
    <h4>Evaluations with this participant completing</h4>
    @if (Model.Ratees != null)
    {
    <table class="table table-striped table-hover table-condensed" id="rateesContainer">
        <thead>
            <tr>
                <th>Ratee Name</th>
                <th>Completing As</th>
                <th>Last Email</th>
                <th>Status</th>
            </tr>
        </thead>    
    @foreach (var item in Model.Ratees)
    {
        <tr class="align-middle">
            <td>@item.ParticipantNameFirst @item.ParticipantNameLast (@item.ParticipantEmail)</td>
            <td>@item.ParticipantRoleName</td>
            <td>@item.EvaluationParticipantDateLastEmailed?.ToString("g")</td>
            <td>
                <a class="btn btn-sm btn-sm-nopad">
                    @Html.Raw(item.EvaluationParticipantStatusDecoration)
                    @item.EvaluationParticipantStatusName
                </a>
            </td>
        </tr>
    }
    </table>
    }
    else
    {
        <span class="form-control-plaintext">No Raters found.</span>
    }
</div>

<h4>Participant Details</h4>
<form asp-action="SaveParticipant" asp-controller="Admin" method="post">
    <input type="hidden" asp-for="Participant.ParticipantId" />
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div class="form-group">
        <label asp-for="Participant.ParticipantNameFirst"></label>
        <input asp-for="Participant.ParticipantNameFirst" class="form-control" />
        <span asp-validation-for="Participant.ParticipantNameFirst" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Participant.ParticipantNameLast"></label>
        <input asp-for="Participant.ParticipantNameLast" class="form-control" />
        <span asp-validation-for="Participant.ParticipantNameLast" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Participant.ParticipantEmail"></label>
        <input asp-for="Participant.ParticipantEmail" class="form-control" />
        <span asp-validation-for="Participant.ParticipantEmail" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Participant.ParticipantIsActive">Is Active?</label>
        <input asp-for="Participant.ParticipantIsActive" type="checkbox" />
    </div>
    <div class="form-group">
        <label asp-for="Participant.ParticipantHasRegistered">&nbsp;</label>
        @(Model.Participant != null && Model.Participant.ParticipantHasRegistered ? "" : "Participant has not yet registered on the site. Please resend their invitation to prompt them to create their account.")
        <input asp-for="Participant.ParticipantHasRegistered" type="hidden" disabled />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="@ViewBag.ReturnUrl" class="btn btn-secondary">Cancel</a>
    <a asp-action="AddParticipantToEvaluation" 
       asp-controller="Admin" 
       asp-route-participantId="@(Model.Participant != null ? Model.Participant.ParticipantId.ToString() : "")"
       asp-route-returnUrl="@ViewBag.ReturnUrl"
       class="btn btn-secondary">
       Add to active evaluation</a>
</form>

@section Scripts {
    <script>
        $(function () {
            $('#evaluationSelect').change(function () {
                var evalId = $(this).val();
                var url = $(this).data('url');
                var url2 = $(this).data('url2');
                var participantId = '@(Model.Participant != null ? Model.Participant.ParticipantId.ToString() : "")';
                console.log("Selected Evaluation ID: " + evalId + " participantId: " + participantId + ", URL: " + url + ", URL2: " + url2);
                $.get(url, { evaluationId: evalId, participantId: participantId }, function (data) {
                    $('#ratersContainer').html(data);
                });
                $.get(url2, { evaluationId: evalId, participantId: participantId }, function (data) {
                    $('#rateesContainer').html(data);
                });
            });
        });

        $(document).ready(function () {
            // Trigger change event to load initial data
            // Find the first option containing the word "Active" and select it
            $('#evaluationSelect option').each(function () {
                if ($(this).text().includes("Active")) {
                    $(this).prop('selected', true);
                    return false; // Break the loop after selecting the first match
                }
            });

            // Trigger the change event to load the corresponding data
            $('#evaluationSelect').trigger('change');
        });

    </script>
}