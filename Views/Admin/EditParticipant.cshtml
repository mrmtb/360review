@model reviews.Models.AdminParticipantViewModel

@{
    ViewBag.Title = "Edit Participant";
}

<h4>Edit Participant</h4>

<div class="form-group">
    <label>Evaluations</label>
    @if (Model.Evaluations != null && Model.Evaluations.Any())
    {
        <select class="form-select" id="evaluationSelect" name="SelectedEvaluationId" data-participant-id="@(Model.Participant != null ? Model.Participant.ParticipantId.ToString() : "")" data-raters-url="@Url.Action("GetRatersForEvaluation", "Admin")" data-ratees-url="@Url.Action("GetRateesForEvaluation", "Admin")">
            @foreach (var item in Model.Evaluations.OrderByDescending(e => e.EvaluationRaterDueDate))
            {
                <option value="@item.EvaluationId">
                    @item.EvaluationName (@(item.EvaluationActive ? "Active" : "Inactive"))
                </option>
            }
        </select>
    }
    else
    {
        <span class="form-control-plaintext">No evaluations found.</span>
    }
</div>

<div class="form-group">
    <h4>Evaluations with this participant as Ratee</h4>
    <div id="ratersContainer">
        @if (Model.Raters != null && Model.Raters.Any())
        {
            @await Html.PartialAsync("_RatersTablePartial", Model.Raters)
        }
        else
        {
            <span class="form-control-plaintext">No Raters found.</span>
        }
    </div>
</div>

<div class="form-group">
    <h4>Evaluations with this participant completing</h4>
    <div id="rateesContainer">
        @if (Model.Ratees != null && Model.Ratees.Any())
        {
            @await Html.PartialAsync("_RateesTablePartial", Model.Ratees)
        }
        else
        {
            <span class="form-control-plaintext">No evaluations found.</span>
        }
    </div>
</div>

<h4>Participant Details</h4>
<form asp-action="SaveParticipant" asp-controller="Admin" method="post" data-busy-submit data-busy-text="Saving...">
    <input type="hidden" asp-for="Participant.ParticipantId" />
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div class="form-group">
        <label asp-for="Participant.ParticipantNameFirst"></label>
        <input asp-for="Participant.ParticipantNameFirst" class="form-control" />
        <span asp-validation-for="Participant.ParticipantNameFirst" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Participant.ParticipantNameLast"></label>
        <input asp-for="Participant.ParticipantNameLast" class="form-control" />
        <span asp-validation-for="Participant.ParticipantNameLast" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Participant.ParticipantEmail"></label>
        <input asp-for="Participant.ParticipantEmail" class="form-control" />
        <span asp-validation-for="Participant.ParticipantEmail" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Participant.ParticipantIsActive">Is Active?</label>
        <input asp-for="Participant.ParticipantIsActive" type="checkbox" />
    </div>
    <div class="form-group">
        <label asp-for="Participant.ParticipantHasRegistered">&nbsp;</label>
        @(Model.Participant != null && Model.Participant.ParticipantHasRegistered ? "" : "Participant has not yet registered on the site. Please resend their invitation to prompt them to create their account.")
        <input asp-for="Participant.ParticipantHasRegistered" type="hidden" disabled />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="@ViewBag.ReturnUrl" class="btn btn-secondary">Cancel</a>
    <a asp-action="AddParticipantToEvaluation" 
       asp-controller="Admin" 
       asp-route-participantId="@(Model.Participant != null ? Model.Participant.ParticipantId.ToString() : "")"
       asp-route-returnUrl="@ViewBag.ReturnUrl"
       class="btn btn-secondary">
       Add to active evaluation</a>
</form>

@section Scripts {
    <script src="/js/pages/admin-edit-participant.js" asp-append-version="true"></script>
}
