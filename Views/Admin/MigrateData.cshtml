@model List<(string Name, string Sql, string Status)>

<!DOCTYPE html>
<html>
<head>
    <title>Data Migration Status</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5">
        <h1>Data Migration Status</h1>
        <table class="table table-bordered mt-4">
            <thead>
                <tr>
                    <th>Operation Name</th>
                    <th>SQL Statement</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td><pre>@item.Sql</pre></td>
                        <td>@item.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
