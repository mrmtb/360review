@model IEnumerable<vwReminders>

@{
    ViewBag.Title = "Manage Reminders";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.0/css/dataTables.bootstrap5.min.css">
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Send reminders</h4>
    <form id="participantForm" method="post" action="/Admin/RemindSelectedRatees">
        <button type="submit" id="submitButton" class="btn btn-primary" disabled>Send Reminders</button>
    </form>
</div>

<table class="table table-hover table-sm align-middle" id="remindersTable">
    <thead>
        <tr>
            <th class="no-sort"><input type="checkbox" id="selectAll" /></th>
            <th>Ratee</th>
            <th>Rater</th>
            <th>Role</th>
            <th>Date Added</th>
            <th>Last Reminder</th>
            <th class="no-sort"></th>
        </tr>
    </thead>
    <tbody>

    @foreach (var p in Model)
    {
        <tr class="align-middle">
            <td>
                <input type="checkbox" class="select-row" data-ratee-id="@p.ParticipantId" />
            </td>
            <td>@p.RateeNameCombined</td>
            <td>@p.ParticipantNameCombined</td>
            <td>@p.ParticipantRoleName</td>
            <td>@p.EvaluationParticipantDateAdded?.ToString("g")</td>
            <td>@p.EvaluationParticipantDateLastEmailed?.ToString("g")</td>
            <td>
                <a asp-action="RemindRatee" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" class="btn btn-sm btn-sm-nopad">
                    <i class="bi bi-bookmarks"></i>&nbsp;Remind
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination justify-content-center pagination-sm" id="pagination"></ul>
</nav>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.bootstrap5.min.js"></script>
    <script>
        var rowsPerPage = 25;
        var $tableRows;

        $(document).ready(function () {
            console.log("Initializing reminders table...");
            // Initialize DataTable with custom column definitions
            $('#remindersTable').DataTable({
                responsive: true,
                pageLength: 25,
                order: [[4, 'desc']],
                columnDefs: [
                    { targets: 0, orderable: false },
                    { targets: -1, orderable: false },
                    { type: 'date', targets: [4, 5] }
                ],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search reminders..."
                }
            });

            $('#pagination').on('click', 'a', function (e) {
                e.preventDefault();
                var page = parseInt($(this).text());
            });

            // Add event listener to the header checkbox
            $('#selectAll').on('change', function () {
                console.log("Header checkbox changed");
                var isChecked = $(this).is(':checked');
                // Check or uncheck all visible row checkboxes based on the header checkbox
                $('table tbody tr:visible input[type="checkbox"]').prop('checked', isChecked);
                toggleSubmitButton();
            });

            // Disable the submit button initially
            $('#submitButton').prop('disabled', true);

            // Function to toggle the submit button based on checkbox selection
            function toggleSubmitButton() {
                var anyChecked = $('table tbody tr:visible input[type="checkbox"]:checked').length > 0;
                $('#submitButton').prop('disabled', !anyChecked);
            }

            // Add event listener to checkboxes to toggle the submit button
            $('table tbody tr:visible input[type="checkbox"]').on('change', function () {
                toggleSubmitButton();
            });

            // Initial check to set the button state
            toggleSubmitButton();

            // Add event listener to the submit button
            $('#submitButton').on('click', function (e) {
                e.preventDefault(); // Prevent default form submission

                // Compile selected participant IDs
                var participantIds = [];
                $('table tbody tr:visible input[type="checkbox"]:checked').each(function () {
                    participantIds.push($(this).data('ratee-id'));
                });

                // Submit the participant IDs as multiple form values
                if (participantIds.length > 0) {
                    var form = $('#participantForm');
                    form.empty(); // Clear any existing inputs
                    participantIds.forEach(function (id) {
                        form.append('<input type="hidden" name="participantIds" value="' + id + '" />');
                    });
                    form.submit();
                } else {
                    alert('No participants selected.');
                }
            });
        });
    </script>
}