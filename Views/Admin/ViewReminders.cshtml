@model IEnumerable<vwReminders>

@{
    ViewBag.Title = "Manage Reminders";
    var reminders = Model?.ToList() ?? new List<vwReminders>();
    var hasReminders = reminders.Any();
}

@section Styles {
    <link rel="stylesheet" href="/vendor/datatables/dataTables.bootstrap5.min.css">
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Send reminders</h4>
    <form id="participantForm" method="post" action="/Admin/RemindSelectedRatees" data-busy-submit data-busy-text="Sending..." class="@(hasReminders ? "" : "d-none")">
        <button type="submit" id="submitButton" class="btn btn-primary" disabled>Send Reminders</button>
    </form>
</div>

@if (!hasReminders)
{
    @await Html.PartialAsync("_EmptyState", new ViewDataDictionary(ViewData)
    {
        ["IconClass"] = "bi bi-bell",
        ["Title"] = "No reminders needed",
        ["Message"] = "Everyone in the reminder queue has been contacted."
    })
}
else
{
    <table class="table table-hover table-sm align-middle mobile-stack" id="remindersTable">
        <thead>
            <tr>
                <th class="no-sort"><input type="checkbox" id="selectAll" /></th>
                <th>Ratee</th>
                <th>Rater</th>
                <th>Role</th>
                <th>Date Added</th>
                <th>Last Reminder</th>
                <th class="no-sort"></th>
            </tr>
        </thead>
        <tbody>

        @foreach (var p in reminders)
        {
            <tr class="align-middle">
                <td data-label="Select">
                    <input type="checkbox" class="select-row" data-ratee-id="@p.ParticipantId" />
                </td>
                <td data-label="Ratee">@p.RateeNameCombined</td>
                <td data-label="Rater">@p.ParticipantNameCombined</td>
                <td data-label="Role">@p.ParticipantRoleName</td>
                <td data-label="Date Added">@p.EvaluationParticipantDateAdded?.ToString("g")</td>
                <td data-label="Last Reminder">@p.EvaluationParticipantDateLastEmailed?.ToString("g")</td>
                <td data-label="Actions">
                    <button type="button"
                            class="btn btn-sm btn-sm-nopad js-remind-action"
                            hx-post="@Url.Action("RemindRateeAjax", "Admin")"
                            hx-vals='{"participantId":"@p.ParticipantId"}'
                            hx-swap="none">
                        <i class="bi bi-bookmarks"></i>&nbsp;Remind
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <nav>
        <ul class="pagination justify-content-center pagination-sm" id="pagination"></ul>
    </nav>
}

@section Scripts {
    @if (hasReminders)
    {
        <script src="/vendor/datatables/dataTables.min.js"></script>
        <script src="/vendor/datatables/dataTables.bootstrap5.min.js"></script>
        @await Html.PartialAsync("_DataTableInit", new ViewDataDictionary(ViewData)
        {
            ["Selector"] = "#remindersTable",
            ["PageLength"] = "25",
            ["SaveState"] = "false",
            ["OrderJs"] = "[[4, 'desc']]",
            ["ColumnDefsJs"] = "[{ targets: 0, orderable: false }, { targets: -1, orderable: false }, { type: 'date', targets: [4, 5] }]",
            ["SearchPlaceholder"] = "Search reminders..."
        })
    }
    <script src="/js/pages/admin-view-reminders.js" asp-append-version="true"></script>
}
