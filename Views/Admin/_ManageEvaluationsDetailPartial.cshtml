@using reviews.Services
@model reviews.Models.Evaluation

@{
    var surveyVersionOptions = ViewData["SurveyVersionOptions"] as List<SurveyVersionOption> ?? new List<SurveyVersionOption>();
    var currentTemplatePath = Model.CurrentSurveyDefinitionVersion?.TemplatePath ?? Model.EvaluationFolder;
}

<div class="card">
    <div class="card-header">
        <h5>
            @if (Model.EvaluationId != Guid.Empty) {<text>Details for @Model.EvaluationName</text>} else {<text>Create New Evaluation</text>}
        </h5>
    </div>
    <div class="card-body">
        <form asp-action="SaveEvaluation" method="post" data-busy-submit data-busy-text="Saving...">
            <input type="hidden" name="selectedModel" value="@ViewData["SelectedModel"]" />
            <input type="hidden" name="EvaluationId" value="@Model.EvaluationId" />
            <div class="mb-3 row align-items-center">
                <label class="col-2 col-form-label fw-bold" for="EvaluationActive">Evaluation Active?</label>
                    <div class="col">
                        <input type="hidden" class="form-check-input" name="initialEvaluationActive" id="initialEvaluationActive" value="@(Model.EvaluationActive ? "true" : "false")"  />
                        <select class="form-select" id="EvaluationActive" name="EvaluationActive">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
            </div>  
            <div class="mb-3 row align-items-center">
                <label class="col-2 col-form-label fw-bold" for="EvaluationName">Evaluation Name</label>
                    <div class="col">
                        <input type="hidden" class="form-control" name="initialEvaluationName" id="initialEvaluationName" value="@Model.EvaluationName" />
                        <input type="text" class="form-control" name="EvaluationName" id="EvaluationName" value="@Model.EvaluationName" />
                    </div>
            </div>
            <div class="mb-3 row align-items-center">
                <label class="col-2 col-form-label fw-bold" for="CurrentSurveyDefinitionVersionId">Survey Version</label>
                <div class="col">
                    <input type="hidden" name="initialCurrentSurveyDefinitionVersionId" value="@Model.CurrentSurveyDefinitionVersionId" />
                    <select class="form-select" id="CurrentSurveyDefinitionVersionId" name="CurrentSurveyDefinitionVersionId">
                        <option value="">Select a survey version</option>
                        @foreach (var option in surveyVersionOptions)
                        {
                            if (option.SurveyDefinitionVersionId == Model.CurrentSurveyDefinitionVersionId)
                            {
                                <option value="@option.SurveyDefinitionVersionId" selected>@option.DisplayName</option>
                            }
                            else
                            {
                                <option value="@option.SurveyDefinitionVersionId">@option.DisplayName</option>
                            }
                        }
                    </select>
                    <div class="form-text">
                        Respondents who already started stay pinned to their assigned version. New starters use the selected version.
                    </div>
                </div>
            </div>
            <div class="mb-3 row align-items-center">
                <label class="col-2 col-form-label fw-bold" for="surveyTemplatePath">Template Source</label>
                <div class="col">
                    <input type="hidden" class="form-control" name="initialEvaluationFolder" id="initialEvaluationFolder" value="@Model.EvaluationFolder" />
                    <input type="text" class="form-control" name="surveyTemplatePath" id="surveyTemplatePath" value="@currentTemplatePath" readonly="@(Model.CurrentSurveyDefinitionVersion?.IsPublished == true)" />
                </div>
            </div>
            <div class="mb-3 row align-items-center">
                <label class="col-2 col-form-label fw-bold" for="EvaluationHelpContact">Evaluation Help Contact</label>
                    <div class="col">
                        <input type="hidden" class="form-control" name="initialEvaluationHelpContact" id="initialEvaluationHelpContact" value="@Model.EvaluationHelpContact" />
                        <input type="text" class="form-control" name="EvaluationHelpContact" id="EvaluationHelpContact" value="@Model.EvaluationHelpContact" />
                    </div>
            </div>
            <div class="mb-3 row align-items-center">
                <label class="col-2 col-form-label fw-bold" for="EvaluationMaxRaters">Evaluation Max Raters</label>
                    <div class="col">
                        <input type="hidden" class="form-control" name="initialEvaluationMaxRaters" id="initialEvaluationMaxRaters" value="@Model.EvaluationMaxRaters" />
                        <input type="number" class="form-control" name="EvaluationMaxRaters" id="EvaluationMaxRaters" value="@Model.EvaluationMaxRaters" />
                    </div>
            </div>
            <div class="mb-3 row align-items-center">
                <label class="col-2 col-form-label fw-bold" for="EvaluationOpenDate">Evaluation Open Date</label>
                    <div class="col">
                        <input type="hidden" class="form-control" name="initialEvaluationOpenDate" id="initialEvaluationOpenDate" value="@(@Model.EvaluationOpenDate is DateTime dt1 ? dt1.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        <input type="datetime-local" class="form-control" name="EvaluationOpenDate" id="EvaluationOpenDate" value="@(@Model.EvaluationOpenDate is DateTime dt2 ? dt2.ToString("yyyy-MM-ddTHH:mm") : "")" />
                    </div>
            </div>
            <div class="mb-3 row align-items-center">
                <label class="col-2 col-form-label fw-bold" for="EvaluationRateeDueDate">Evaluation Ratee Due Date</label>
                    <div class="col">
                        <input type="hidden" class="form-control" name="initialEvaluationRateeDueDate" id="initialEvaluationRateeDueDate" value="@(@Model.EvaluationRateeDueDate is DateTime dt3 ? dt3.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        <input type="datetime-local" class="form-control" name="EvaluationRateeDueDate" id="EvaluationRateeDueDate" value="@(@Model.EvaluationRateeDueDate is DateTime dt4 ? dt4.ToString("yyyy-MM-ddTHH:mm") : "")" />
                    </div>
            </div>
            <div class="mb-3 row align-items-center">
                <label class="col-2 col-form-label fw-bold" for="EvaluationRaterDueDate">Evaluation Rater Due Date</label>
                    <div class="col">
                        <input type="hidden" class="form-control" name="initialEvaluationRaterDueDate" id="initialEvaluationRaterDueDate" value="@(@Model.EvaluationRaterDueDate is DateTime dt5 ? dt5.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        <input type="datetime-local" class="form-control" name="EvaluationRaterDueDate" id="EvaluationRaterDueDate" value="@(@Model.EvaluationRaterDueDate is DateTime dt6 ? dt6.ToString("yyyy-MM-ddTHH:mm") : "")" />
                    </div>
            </div>
            <div class="mb-3 row align-items-center">
                <label class="col-2 col-form-label fw-bold" for="EvaluationTestEmails">Evaluations Test Email</label>
                    <div class="col">
                        <input type="hidden" class="form-control" name="initialEvaluationTestEmails" id="initialEvaluationTestEmails" value="@(@Model.EvaluationTestEmails ? "true" : "false")" />
                        <select class="form-select" id="EvaluationTestEmails" name="EvaluationTestEmails">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
            </div>
            <div class="mb-3">
                    <input type="hidden" class="form-control" name="ClientId" id="ClientId" value="@Model.ClientId" />
            </div>
            @if (Model.EvaluationId != Guid.Empty)
            {
                <div class="mb-3 d-flex gap-2 flex-wrap">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            hx-get="@Url.Action("GetSurveyManagement", "Admin", new { evaluationId = Model.EvaluationId })"
                            hx-target="#detailsContainer"
                            hx-swap="innerHTML">
                        <i class="bi bi-diagram-3"></i> Manage Survey Versions
                    </button>
                </div>
            }
            <button type="submit" class="btn btn-primary">
                @(Model.EvaluationId == Guid.Empty ? "Create" : "Save")
            </button>
            <a class="btn btn-secondary ms-2 cancel-details" href="#">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </form>
    </div>
</div>
