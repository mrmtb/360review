@model reviews.Models.SurveyManagementViewModel

@{
    var message = ViewData["SurveyManagementMessage"]?.ToString();
    var severity = ViewData["SurveyManagementMessageSeverity"]?.ToString() ?? "success";
    var alertClass = severity switch
    {
        "danger" => "alert-danger",
        "warning" => "alert-warning",
        _ => "alert-success"
    };
    var switchWarning = Model.CurrentPinnedParticipantCount > 0
        ? $"{Model.CurrentPinnedParticipantCount} participants are pinned to the current version and will stay there. Continue switching this evaluation for new starters only?"
        : string.Empty;
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-1">Survey Management for @Model.EvaluationName</h5>
            <div class="text-muted small">
                Current version:
                @if (!string.IsNullOrWhiteSpace(Model.CurrentSurveyDisplayName))
                {
                    <span>@Model.CurrentSurveyDisplayName</span>
                }
                else
                {
                    <span>Not configured</span>
                }
            </div>
        </div>
        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                hx-get="@Url.Action("GetEvaluationDetails", "Admin", new { id = Model.EvaluationId })"
                hx-target="#detailsContainer"
                hx-swap="innerHTML">
            <i class="bi bi-arrow-left"></i> Back to Evaluation
        </button>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert @alertClass" role="alert">@message</div>
        }

        @if (Model.CurrentPinnedParticipantCount > 0)
        {
            <div class="alert alert-warning" role="alert">
                @Model.CurrentPinnedParticipantCount participants are pinned to the current version. Switching versions only affects new starters.
            </div>
        }

        <div class="d-flex gap-2 flex-wrap mb-3">
            <form asp-action="CreateSurveyVersion"
                  method="post"
                  class="d-inline"
                  hx-post="@Url.Action("CreateSurveyVersion", "Admin")"
                  hx-target="#detailsContainer"
                  hx-swap="innerHTML">
                @Html.AntiForgeryToken()
                <input type="hidden" name="evaluationId" value="@Model.EvaluationId" />
                <input type="hidden" name="selectedModel" value="Evaluations" />
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-layers"></i> Create New Version
                </button>
            </form>
            <form asp-action="CreateSurvey"
                  method="post"
                  class="d-inline"
                  hx-post="@Url.Action("CreateSurvey", "Admin")"
                  hx-target="#detailsContainer"
                  hx-swap="innerHTML">
                @Html.AntiForgeryToken()
                <input type="hidden" name="evaluationId" value="@Model.EvaluationId" />
                <input type="hidden" name="selectedModel" value="Evaluations" />
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-file-earmark-plus"></i> Create New Survey
                </button>
            </form>
        </div>

        @if (Model.Versions.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover table-condensed">
                    <thead>
                        <tr>
                            <th>Survey</th>
                            <th>Version</th>
                            <th>Template Key</th>
                            <th>Template Path</th>
                            <th>Usage</th>
                            <th>Published</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var version in Model.Versions)
                    {
                        <tr class="align-middle">
                            <td>
                                <div>@version.SurveyDefinitionName</div>
                                @if (version.IsCurrentForEvaluation)
                                {
                                    <span class="badge text-bg-primary">Current for evaluation</span>
                                }
                            </td>
                            <td>v@version.VersionNumber</td>
                            <td><code>@version.TemplateKey</code></td>
                            <td style="min-width: 320px;">
                                <form asp-action="SaveSurveyTemplatePath"
                                      method="post"
                                      class="d-flex gap-2 align-items-center"
                                      hx-post="@Url.Action("SaveSurveyTemplatePath", "Admin")"
                                      hx-target="#detailsContainer"
                                      hx-swap="innerHTML">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="evaluationId" value="@Model.EvaluationId" />
                                    <input type="hidden" name="surveyDefinitionVersionId" value="@version.SurveyDefinitionVersionId" />
                                    <input type="hidden" name="selectedModel" value="Evaluations" />
                                    <input type="text" class="form-control form-control-sm" name="templatePath" value="@version.TemplatePath" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                </form>
                            </td>
                            <td>
                                <div class="small">
                                    <a href="#"
                                       hx-get="@Url.Action("GetSurveyVersionUsage", "Admin", new { evaluationId = Model.EvaluationId, surveyDefinitionVersionId = version.SurveyDefinitionVersionId, usageType = "pinned" })"
                                       hx-target="#surveyUsageDetails"
                                       hx-swap="innerHTML">Pinned: @version.PinnedParticipantCount</a>
                                </div>
                                <div class="small">
                                    <a href="#"
                                       hx-get="@Url.Action("GetSurveyVersionUsage", "Admin", new { evaluationId = Model.EvaluationId, surveyDefinitionVersionId = version.SurveyDefinitionVersionId, usageType = "started" })"
                                       hx-target="#surveyUsageDetails"
                                       hx-swap="innerHTML">Started: @version.StartedResponseCount</a>
                                </div>
                                <div class="small">
                                    <a href="#"
                                       hx-get="@Url.Action("GetSurveyVersionUsage", "Admin", new { evaluationId = Model.EvaluationId, surveyDefinitionVersionId = version.SurveyDefinitionVersionId, usageType = "submitted" })"
                                       hx-target="#surveyUsageDetails"
                                       hx-swap="innerHTML">Submitted: @version.SubmittedResponseCount</a>
                                </div>
                            </td>
                            <td>@(version.IsPublished ? "Yes" : "No")</td>
                            <td>@version.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary me-2"
                                        hx-get="@Url.Action("GetSurveyVersionDetail", "Admin", new { evaluationId = Model.EvaluationId, surveyDefinitionVersionId = version.SurveyDefinitionVersionId })"
                                        hx-target="#detailsContainer"
                                        hx-swap="innerHTML">
                                    Edit Version
                                </button>
                                @if (!version.IsCurrentForEvaluation)
                                {
                                    <form asp-action="SetCurrentSurveyVersion"
                                          method="post"
                                          class="d-inline"
                                          hx-post="@Url.Action("SetCurrentSurveyVersion", "Admin")"
                                          hx-target="#detailsContainer"
                                          hx-swap="innerHTML"
                                          onsubmit="return @Html.Raw(string.IsNullOrWhiteSpace(switchWarning) ? "true" : $"confirm({System.Text.Json.JsonSerializer.Serialize(switchWarning)})");">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="evaluationId" value="@Model.EvaluationId" />
                                        <input type="hidden" name="surveyDefinitionVersionId" value="@version.SurveyDefinitionVersionId" />
                                        <input type="hidden" name="selectedModel" value="Evaluations" />
                                        <input type="hidden" name="forceSwitch" value="true" />
                                        <button type="submit" class="btn btn-sm btn-primary">Use for New Starts</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Active</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div id="surveyUsageDetails" class="mt-3"></div>
        }
        else
        {
            <span class="form-control-plaintext">No survey versions found.</span>
        }
    </div>
</div>
