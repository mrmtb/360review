@model IEnumerable<vwAdminParticipants>

@{
    ViewBag.Title = "Manage Participants";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.0/css/dataTables.bootstrap5.min.css">
}

<h4>Participants</h4>

<table class="table table-hover table-sm align-middle" id="participantsTable">
    <thead>
        <tr>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Is Ratee?</th>
            <th>Is Active?</th>
            <th>Date Last Emailed</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>

    @foreach (var p in Model)
    {
        <tr style="@(p.ParticipantIsActive ? "" : "font-style:italic")" class="align-middle">
            <td>@p.ParticipantEmail</td>
            <td>@p.ParticipantNameFirst</td>
            <td>@p.ParticipantNameLast</td>
            <td>@p.IsRatee</td>
            <td>@p.ParticipantIsActive</td>
            <td>@p.EvaluationParticipantDateLastEmailed?.ToString("g")</td>
            <td>
                <div class="btn-group btn-group-sm" role="group">
                    <a asp-action="DumpParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewParticipants" class="btn btn-outline-secondary" title="View Data">
                        <i class="bi bi-file-text"></i>
                    </a>
                    <a asp-action="EditParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewParticipants" class="btn btn-outline-primary" title="Edit">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="ToggleParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewParticipants" class="btn @(p.ParticipantIsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(p.ParticipantIsActive ? "Disable" : "Re-enable")">
                        <i class="bi bi-@(p.ParticipantIsActive ? "x-circle" : "check-circle")"></i>
                    </a>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination justify-content-center pagination-sm" id="pagination"></ul>
</nav>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.8.4/moment.min.js"></script>
    <script src="https://cdn.datatables.net/plug-ins/2.3.2/sorting/datetime-moment.js"></script>
    
    <script>
        $(document).ready(function () {
            $.fn.dataTable.ext.errMode = 'throw';
            $.fn.dataTable.moment('M/D/YYYY LT', 'en');

            $('#participantsTable').DataTable({
                responsive: true,
                pageLength: 25,
                saveState: true,
                order: [[0, 'asc']],
                columnDefs: [
                    { targets: -1, orderable: false },
                    { type: 'date', targets: 5 }
                ],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search participants..."
                }
            });
        });
    </script>
}