@model IEnumerable<vwAdminParticipants>

@{
    ViewBag.Title = "Manage Participants";
    var participants = Model?.ToList() ?? new List<vwAdminParticipants>();
    var hasParticipants = participants.Any();
}

@section Styles {
    <link rel="stylesheet" href="/vendor/datatables/dataTables.bootstrap5.min.css">
}

<h4>Participants</h4>

@if (!hasParticipants)
{
    @await Html.PartialAsync("_EmptyState", new ViewDataDictionary(ViewData)
    {
        ["IconClass"] = "bi bi-people",
        ["Title"] = "No participants yet",
        ["Message"] = "Participants will appear here after they are imported or created."
    })
}
else
{
    <table class="table table-hover table-sm align-middle mobile-stack" id="participantsTable">
        <thead>
            <tr>
                <th>Email</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Is Ratee?</th>
                <th>Is Active?</th>
                <th>Date Last Emailed</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

        @foreach (var p in participants)
        {
            <tr style="@(p.ParticipantIsActive ? "" : "font-style:italic")" class="align-middle">
                <td data-label="Email">@p.ParticipantEmail</td>
                <td data-label="First Name">@p.ParticipantNameFirst</td>
                <td data-label="Last Name">@p.ParticipantNameLast</td>
                <td data-label="Is Ratee?">@p.IsRatee</td>
                <td data-label="Is Active?">@p.ParticipantIsActive</td>
                <td data-label="Date Last Emailed">@p.EvaluationParticipantDateLastEmailed?.ToString("g")</td>
                <td data-label="Actions">
                    <div class="btn-group btn-group-sm" role="group">
                        <a asp-action="DumpParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewParticipants" class="btn btn-outline-secondary" title="View Data">
                            <i class="bi bi-file-text"></i>
                        </a>
                        <a asp-action="EditParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewParticipants" class="btn btn-outline-primary" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="ToggleParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewParticipants" class="btn @(p.ParticipantIsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(p.ParticipantIsActive ? "Disable" : "Re-enable")" data-confirm="@(p.ParticipantIsActive ? "Disable this participant?" : "Re-enable this participant?")">
                            <i class="bi bi-@(p.ParticipantIsActive ? "x-circle" : "check-circle")"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <nav>
        <ul class="pagination justify-content-center pagination-sm" id="pagination"></ul>
    </nav>
}

@section Scripts {
    @if (hasParticipants)
    {
        <script src="/vendor/datatables/dataTables.min.js"></script>
        <script src="/vendor/datatables/dataTables.bootstrap5.min.js"></script>
        <script src="/vendor/moment/moment.min.js"></script>
        <script src="/vendor/datatables/datetime-moment.js"></script>
        @await Html.PartialAsync("_DataTableInit", new ViewDataDictionary(ViewData)
        {
            ["Selector"] = "#participantsTable",
            ["PageLength"] = "25",
            ["SaveState"] = "true",
            ["OrderJs"] = "[[0, 'asc']]",
            ["ColumnDefsJs"] = "[{ targets: -1, orderable: false }, { type: 'date', targets: 5 }]",
            ["SearchPlaceholder"] = "Search participants...",
            ["MomentFormat"] = "M/D/YYYY LT",
            ["MomentLocale"] = "en"
        })
    }
}
