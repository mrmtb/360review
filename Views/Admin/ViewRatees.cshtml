@model IEnumerable<vwAdminRatees>

@{
    ViewBag.Title = "Manage Ratees";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
}

<h4>Ratees</h4>

<table class="table table-hover table-striped align-middle shadow-sm rounded" id="rateesTable">
    <thead class="table-light">
        <tr>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Date Added</th>
            <th>Date Last Emailed</th>
            <th></th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>

    @foreach (var p in Model)
    {
        <tr class="align-middle">
            <td>@p.ParticipantEmail</td>
            <td>@p.ParticipantNameFirst</td>
            <td>@p.ParticipantNameLast</td>
            <td>@p.EvaluationRateeDateAdded?.ToString("g")</td>
            <td>@p.EvaluationParticipantDateLastEmailed?.ToString("g")</td>
            <td>
                <a asp-action="ViewRaters" asp-controller="Participant" asp-route-participantId="@p.ParticipantId" asp-route-evaluationId="@p.EvaluationId" class="btn btn-sm btn-sm-nopad">
                    <i class="bi bi-arrow-right-square"></i>&nbsp;Edit
                </a>
            </td>
            <td>
                <a asp-action="ToggleParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewRatees" class="btn btn-sm btn-sm-nopad @(p.ParticipantIsActive ? "text-danger" : "text-success")">
                    <i class="bi bi-exclamation-diamond"></i>&nbsp;@(p.ParticipantIsActive ? "Disable" : "Re-enable")
                </a>
            </td>
            <td>
                @{
                    if (p.EvaluationParticipantDateLastEmailed.HasValue)
                    {
                <a asp-action="RemindParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewRatees" class="btn btn-sm btn-sm-nopad">
                    <i class="bi bi-bookmarks"></i>&nbsp;Remind
                </a>
                    }
                    else
                    {
                <a asp-action="InviteParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewRatees" class="btn btn-sm btn-sm-nopad">
                    <i class="bi bi-calendar-event"></i>&nbsp;Invite
                </a>
                    }
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination justify-content-center pagination-sm" id="pagination"></ul>
</nav>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"> </script>
    <script>
        $(document).ready(function () {
            $('#rateesTable').DataTable({
                "searching": true,
                "pageLength": 25,
                "saveState": true,
                columnDefs: [
                    { targets: -1, orderable: false }, 
                    { targets: -2, orderable: false }, 
                    { targets: -3, orderable: false },
                    { type: 'date', targets: [4, 5] }
                ]
            });
        });
    </script>
}