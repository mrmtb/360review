@model IEnumerable<vwAdminRatees>

@{
    ViewBag.Title = "Manage Ratees";
    var ratees = Model?.ToList() ?? new List<vwAdminRatees>();
    var hasRatees = ratees.Any();
}

@section Styles {
    <link rel="stylesheet" href="/vendor/datatables/dataTables.bootstrap5.min.css">
}

<h4>Ratees</h4>

@if (!hasRatees)
{
    @await Html.PartialAsync("_EmptyState", new ViewDataDictionary(ViewData)
    {
        ["IconClass"] = "bi bi-person-badge",
        ["Title"] = "No ratees available",
        ["Message"] = "Ratees will appear here when participants are assigned for evaluations."
    })
}
else
{
    <table class="table table-hover table-sm align-middle mobile-stack" id="rateesTable">
        <thead>
            <tr>
                <th>Email</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Date Added</th>
                <th>Date Last Emailed</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

        @foreach (var p in ratees)
        {
            <tr class="align-middle">
                <td data-label="Email">@p.ParticipantEmail</td>
                <td data-label="First Name">@p.ParticipantNameFirst</td>
                <td data-label="Last Name">@p.ParticipantNameLast</td>
                <td data-label="Date Added">@p.EvaluationRateeDateAdded?.ToString("g")</td>
                <td data-label="Date Last Emailed">@p.EvaluationParticipantDateLastEmailed?.ToString("g")</td>
                <td data-label="Actions">
                    <div class="btn-group btn-group-sm" role="group">
                        <a asp-action="ViewRaters" asp-controller="Participant" asp-route-participantId="@p.ParticipantId" asp-route-evaluationId="@p.EvaluationId" class="btn btn-outline-primary" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="ToggleParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewRatees" class="btn @(p.ParticipantIsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(p.ParticipantIsActive ? "Disable" : "Re-enable")" data-confirm="@(p.ParticipantIsActive ? "Disable this ratee?" : "Re-enable this ratee?")">
                            <i class="bi bi-@(p.ParticipantIsActive ? "x-circle" : "check-circle")"></i>
                        </a>
                        @if (p.EvaluationParticipantDateLastEmailed.HasValue)
                        {
                            <a asp-action="RemindParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewRatees" class="btn btn-outline-info" title="Send Reminder" data-confirm="Send reminder email now?">
                                <i class="bi bi-envelope"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-action="InviteParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewRatees" class="btn btn-outline-success" title="Send Invitation" data-confirm="Send invitation email now?">
                                <i class="bi bi-send"></i>
                            </a>
                        }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <nav>
        <ul class="pagination justify-content-center pagination-sm" id="pagination"></ul>
    </nav>
}

@section Scripts {
    @if (hasRatees)
    {
        <script src="/vendor/datatables/dataTables.min.js"></script>
        <script src="/vendor/datatables/dataTables.bootstrap5.min.js"></script>
        @await Html.PartialAsync("_DataTableInit", new ViewDataDictionary(ViewData)
        {
            ["Selector"] = "#rateesTable",
            ["PageLength"] = "25",
            ["SaveState"] = "true",
            ["OrderJs"] = "[[0, 'asc']]",
            ["ColumnDefsJs"] = "[{ targets: 5, orderable: false }, { type: 'date', targets: [3, 4] }]",
            ["SearchPlaceholder"] = "Search ratees..."
        })
    }
}
