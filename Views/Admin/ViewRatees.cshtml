@model IEnumerable<vwAdminRatees>

@{
    ViewBag.Title = "Manage Ratees";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.0/css/dataTables.bootstrap5.min.css">
}

<h4>Ratees</h4>

<table class="table table-hover table-sm align-middle" id="rateesTable">
    <thead>
        <tr>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Date Added</th>
            <th>Date Last Emailed</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>

    @foreach (var p in Model)
    {
        <tr class="align-middle">
            <td>@p.ParticipantEmail</td>
            <td>@p.ParticipantNameFirst</td>
            <td>@p.ParticipantNameLast</td>
            <td>@p.EvaluationRateeDateAdded?.ToString("g")</td>
            <td>@p.EvaluationParticipantDateLastEmailed?.ToString("g")</td>
            <td>
                <div class="btn-group btn-group-sm" role="group">
                    <a asp-action="ViewRaters" asp-controller="Participant" asp-route-participantId="@p.ParticipantId" asp-route-evaluationId="@p.EvaluationId" class="btn btn-outline-primary" title="Edit">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="ToggleParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewRatees" class="btn @(p.ParticipantIsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(p.ParticipantIsActive ? "Disable" : "Re-enable")">
                        <i class="bi bi-@(p.ParticipantIsActive ? "x-circle" : "check-circle")"></i>
                    </a>
                    @if (p.EvaluationParticipantDateLastEmailed.HasValue)
                    {
                        <a asp-action="RemindParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewRatees" class="btn btn-outline-info" title="Send Reminder">
                            <i class="bi bi-envelope"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-action="InviteParticipant" asp-controller="Admin" asp-route-participantId="@p.ParticipantId" asp-route-returnUrl="ViewRatees" class="btn btn-outline-success" title="Send Invitation">
                            <i class="bi bi-send"></i>
                        </a>
                    }
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination justify-content-center pagination-sm" id="pagination"></ul>
</nav>

@section Scripts {
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#rateesTable').DataTable({
                responsive: true,
                pageLength: 25,
                saveState: true,
                order: [[0, 'asc']],
                columnDefs: [
                    { targets: 5, orderable: false },
                    { type: 'date', targets: [3, 4] }
                ],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search ratees..."
                }
            });
        });
    </script>
}