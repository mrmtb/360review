@using reviews.Models

@model List<vwEvaluationsToComplete>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
    <table class="table table-striped table-hover table-sm align-middle mobile-stack admin-edit-table mb-0">
        <colgroup>
            <col class="col-person" />
            <col class="col-role" />
            <col class="col-last-email" />
            <col class="col-status" />
        </colgroup>
        <thead>
            <tr>
                <th>Ratee Name</th>
                <th>Completing As</th>
                <th>Last Email</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td data-label="Ratee Name" class="text-break">@item.ParticipantNameFirst @item.ParticipantNameLast (@item.ParticipantEmail)</td>
            <td data-label="Completing As">@item.ParticipantRoleName</td>
            <td data-label="Last Email">@item.EvaluationParticipantDateLastEmailed?.ToString("g")</td>
            <td data-label="Status">
                <button class="btn btn-sm btn-sm-nopad" type="button">
                    @Html.Raw(item.EvaluationParticipantStatusDecoration)
                    @item.EvaluationParticipantStatusName
                </button>
            </td>
        </tr>
    }
        </tbody>
    </table>
    </div>
}
else
{
    <span class="form-control-plaintext">No evaluations found.</span>
}
