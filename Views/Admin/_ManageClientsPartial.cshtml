@using reviews.Models

@model IEnumerable<Client>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-hover table-condensed">
        <thead>
            <tr>
                <th>Client Name</th>
                <th>Logo Location</th>
                <th>Is Active?</th>
                <th>Email Domain</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr class="align-middle">
                <td>@item.ClientName</td>
                <td>@item.ClientLogoLocation</td>
                <td>@(item.ClientIsActive ? "Yes" : "No")</td>
                <td>@item.ClientEmailDomain</td>
                <td>
                    <a
                        class="btn btn-primary btn-sm"
                        hx-get="@Url.Action("GetClientDetails", "Admin", new { id = item.ClientId })"
                        hx-target="#detailsContainer"
                        hx-swap="innerHTML">
                        <i class="bi bi-pencil-square"></i> Details
                    </a>
                    @{
                        var activeClientObj = ViewData["ActiveClient"];
                        Guid? activeClientId = activeClientObj as Guid?;
                    }
                    @if (activeClientId.HasValue && activeClientId.Value == item.ClientId)
                    {
                    <a href="#" class="btn btn-sm ml-2 @(item.ClientIsActive ? "btn-success" : "")">
                        <i class="bi bi-check-circle"></i> @(item.ClientIsActive ? "Active" : "Not Active")
                    </a>
                    }
                    else
                    {
                    <a asp-action="SetActiveClient" asp-route-clientId="@item.ClientId" class="btn btn-sm ml-2 @(item.ClientId == activeClientId ? "disabled" : "")">
                        <i class="bi bi-check"></i> Set Active
                    </a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <span class="form-control-plaintext">Nothing returned. </span>
}
