@model reviews.Models.Client

@{
    ViewBag.Title = "Client Details";
}

<h2>@Model.ClientName</h2>
<p><strong>Logo:</strong> @Model.ClientLogoLocation</p>
<p><strong>Help Contact:</strong> @Model.ClientHelpContact</p>
<p><strong>Active:</strong> @Model.ClientIsActive</p>
<p><strong>Email Domain:</strong> @Model.ClientEmailDomain</p>
<a asp-action="Edit" asp-route-id="@Model.ClientId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>