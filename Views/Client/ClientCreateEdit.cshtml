@model reviews.Models.Client

@{
    ViewBag.Title = Model.ClientId == Guid.Empty ? "Create Client" : "Edit Client";
}

<h2>@ViewBag.Title</h2>

<form asp-action="@ViewBag.Title.Replace(" ", "")">
    <div class="form-group">
        <label asp-for="ClientName"></label>
        <input asp-for="ClientName" class="form-control" />
        <span asp-validation-for="ClientName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ClientLogoLocation"></label>
        <input asp-for="ClientLogoLocation" class="form-control" />
        <span asp-validation-for="ClientLogoLocation" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ClientHelpContact"></label>
        <input asp-for="ClientHelpContact" class="form-control" />
        <span asp-validation-for="ClientHelpContact" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ClientIsActive"></label>
        <input asp-for="ClientIsActive" type="checkbox" />
        <span asp-validation-for="ClientIsActive" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ClientEmailDomain"></label>
        <input asp-for="ClientEmailDomain" class="form-control" />
        <span asp-validation-for="ClientEmailDomain" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>