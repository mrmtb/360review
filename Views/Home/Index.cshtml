@model HomeViewModel

@{
    ViewBag.Title = "Home";
}

@if (User.IsInRole("Admin"))
{
    <div class="container mt-4">
        <h4>Welcome, Administrator</h4>
        <h5>Active Client: @Model.LocalClientName</h5>
        <p>Use the navigation menu to manage clients, evaluations, participants, and email templates.</p>
    </div>
}
else if (User.IsInRole("Client"))
{
    <div class="container mt-4">
        <h4>Welcome, @Model.Email</h4>
        <h5>Client: @Model.LocalClientName</h5>
        <p>Use the navigation menu to access your client portal.</p>
    </div>
}
else if (User.IsInRole("Participant"))
{
    <div class="container mt-4">
        <h4 class="mb-4">Welcome back!</h4>
        
        <div class="row g-4">
            @if (!string.IsNullOrEmpty(Model.RatersText))
            {
                <div class="col-md-6">
                    <div class="card border-info shadow-sm h-100 card-hover">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-info-circle text-info me-2"></i>
                                Action Required
                            </h5>
                            <p class="card-text">@Html.Raw(Model.RatersText)</p>
                        </div>
                    </div>
                </div>
            }
            
            @if (!string.IsNullOrEmpty(Model.EvaluationsText))
            {
                <div class="col-md-6">
                    <div class="card border-primary shadow-sm h-100 card-hover">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-clipboard-check text-primary me-2"></i>
                                Evaluations
                            </h5>
                            <p class="card-text">@Html.Raw(Model.EvaluationsText)</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="container mt-4">
        <h2>Welcome to the Behavioral Insights System</h2>
        <p>Please use the links to the left to register and login.</p>
    </div>
}
