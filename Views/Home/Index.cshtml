@model HomeViewModel

@{
    ViewBag.Title = "Home";
}

@if (User.IsInRole("Admin"))
{
    <div class="container mt-4">
        <h4>Welcome, Administrator</h4>
        <h5>Active Client: @Model.LocalClientName</h5>
        <p>Use the navigation menu to manage clients, evaluations, participants, and email templates.</p>
    </div>
}
else if (User.IsInRole("Client"))
{
    <div class="container mt-4">
        <h4>Welcome, @Model.Email</h4>
        <h5>Client: @Model.LocalClientName</h5>
        <p>Use the navigation menu to access your client portal.</p>
    </div>
}
else if (User.IsInRole("Participant"))
{
    <div class="container mt-4">
        <h4>Welcome back!</h4>
        
        @if (!string.IsNullOrEmpty(Model.RatersText))
        {
            <div class="alert alert-info mt-3">
                <i class="bi bi-info-circle"></i> @Html.Raw(Model.RatersText)
            </div>
        }
        
        @if (!string.IsNullOrEmpty(Model.EvaluationsText))
        {
            <div class="alert alert-primary mt-3">
                <i class="bi bi-clipboard-check"></i> @Html.Raw(Model.EvaluationsText)
            </div>
        }
    </div>
}
else
{
    <div class="container mt-4">
        <h2>Welcome to the Behavioral Insights System</h2>
        <p>Please use the links to the left to register and login.</p>
    </div>
}

