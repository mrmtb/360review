@model HomeViewModel

@{
    ViewBag.Title = "Home";
}

@if (User.IsInRole("Admin"))
{
    <h4>You are now logged in as an Admin.</h4>
    <h5>Your active client is @Model.LocalClientName</h5>

    @foreach (var property in Model.GetType().GetProperties())
    {
    <div>@property.Name = @property.GetValue(Model)</div>
    }

}
else if (User.IsInRole("Participant") || Model.LocalClientId != Guid.Empty)
{
    <h4>You are now logged in.</h4>
    <h5>@Html.Raw(Model.EvaluationsText)</h5>
    <h5>@Html.Raw(Model.RatersText)</h5>

    @foreach (var property in Model.GetType().GetProperties())
    {
    <div>@property.Name = @property.GetValue(Model)</div>
    }
}
else
{
    <h2>Welcome to the Behavioral Insights system. Please use the links to the left to register and login.</h2>
}

