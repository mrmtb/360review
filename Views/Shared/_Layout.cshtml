@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var showQuickSearch = false;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - reviews</title>
    @RenderSection("Styles", required: false)
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/lib/bootstrap/bootstrap-icons-1.13.1/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/ui-modern.css" asp-append-version="true" />
    <meta name="request-verification-token" content="@antiforgeryToken" />
</head>

<body x-data="{ navOpen: false }" class="app-body">
    <div class="app-shell">
        <aside class="app-sidebar" :class="{ 'is-open': navOpen }">
            <div class="app-sidebar-inner">
                <div class="mb-3">
                    @await Html.PartialAsync("_HeaderPartial")
                </div>

                <ul class="nav nav-pills flex-column mb-auto app-nav" @@click="navOpen = false">
                    @await Html.PartialAsync("_LoginPartial")
                </ul>

                <div class="small text-center app-footer mt-3">
                    &copy; 2026 - Behavioral Insights, LLC <br />
                    <a href="https://www.behavioralinsights.com">www.behavioralinsights.com</a>
                </div>
            </div>
        </aside>

        <div class="app-overlay" x-show="navOpen" @@click="navOpen = false" x-cloak></div>

        <div class="app-content">
            <header class="app-topbar">
                <button type="button" class="btn btn-sm btn-outline-secondary d-lg-none" @@click="navOpen = !navOpen" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="app-topbar-title">@ViewData["Title"]</div>
                @if (showQuickSearch)
                {
                    <button type="button" id="commandPaletteToggle" class="btn btn-sm btn-outline-secondary" aria-label="Quick actions" title="Quick actions ( / )">
                        <i class="bi bi-search"></i>
                    </button>
                }
                <button type="button" id="themeToggle" class="btn btn-sm btn-outline-secondary" aria-label="Toggle theme">
                    <i class="bi bi-circle-half"></i>
                </button>
            </header>

            <main role="main" class="app-main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="/vendor/jquery/jquery-3.7.1.min.js"></script>
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/vendor/htmx/htmx.min.js"></script>
    <script defer src="/vendor/alpine/alpine.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)

    @if (showQuickSearch)
    {
        <div class="modal fade" id="commandPaletteModal" tabindex="-1" aria-labelledby="commandPaletteLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="commandPaletteLabel">Quick Actions</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label for="commandPaletteInput" class="form-label">Jump to a page</label>
                        <input id="commandPaletteInput" type="search" class="form-control mb-3" placeholder="Type to filter actions..." data-autofocus />
                        <div class="list-group command-palette-list" id="commandPaletteList"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</body>
</html>
