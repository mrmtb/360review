<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>reviews</RootNamespace>
    <UserSecretsId>bf30b3af-46db-469c-a656-5196ad6379a5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
